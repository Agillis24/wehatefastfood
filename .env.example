# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# No secret is ever prefixed NEXT_PUBLIC_ - that prefix ships the value to the
# browser. `npm run secrets:scan` fails the build if that rule is broken.

# --- Public (safe in the browser) -------------------------------------------
# Canonical origin. Preview deployments set their own so they do not emit
# production canonical URLs. Canonical host is www; the apex 301s to it.
NEXT_PUBLIC_SITE_ORIGIN=https://www.wehatefastfood.com

# Cookieless analytics. Empty disables it, which is the default in development.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Server only (never expose) ---------------------------------------------
# Tier-1 translation runs (build time) and the tier-2 endpoint (server only).
ANTHROPIC_API_KEY=
