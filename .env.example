# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# No secret is ever prefixed NEXT_PUBLIC_ - that prefix ships the value to the
# browser. `npm run secrets:scan` fails the build if that rule is broken.

# --- Public (safe in the browser) -------------------------------------------
# Canonical origin. Preview deployments set their own so they do not emit
# production canonical URLs. Canonical host is www; the apex 301s to it.
NEXT_PUBLIC_SITE_ORIGIN=https://www.wehatefastfood.com

# Cookieless analytics. Empty disables it, which is the default in development.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Server only (never expose) ---------------------------------------------
# Tier-1 translation runs (build time) and the tier-2 endpoint (server only).
ANTHROPIC_API_KEY=

# Publishing to Instagram and the Facebook Page (scripts/social-publish.mjs).
# Optional - only needed to post from the command line.
#
# FOUR values, not two, and the token types differ. Instagram takes a user
# token; the Facebook Page photo endpoint requires a PAGE access token and a
# user token fails there with an error that does not say so.
#
# None is prefixed NEXT_PUBLIC_ and none ever should be: these can post to the
# accounts. Scopes: instagram_business_basic + instagram_business_content_publish
# for Instagram; pages_show_list + pages_read_engagement + pages_manage_posts
# for the Page.
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
