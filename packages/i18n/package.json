{
  "name": "@wff/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/*": "./messages/*",
    "./generated/manifest.json": "./generated/manifest.json",
    "./translation": {
      "types": "./dist/translation.d.ts",
      "default": "./dist/translation.js"
    }
  },
  "scripts": {
    "build": "tsc --build"
  }
}
